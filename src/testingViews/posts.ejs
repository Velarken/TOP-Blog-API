<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
</head>
<body>
    <h1>All Posts</h1>
    <% posts.map(post => { %>
        <h3><%= post.title %></h3>
        <p><%= post.content %></p>
        <h5>Comments</h5>
        <% comments.map(comment => { %>
            <p><%= comment.content %></p>
        <% }) %>
        
    <% }) %>
</body>
</html>